{
  "name": "local-file-assistant-ui",
  "version": "0.3.0",
  "private": true,
  "description": "A desktop application for managing local files and directories.",
  "author": "tarun",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build:web && electron .",
    "predev": "node scripts/free-dev-lock.js",
    "dev": "concurrently -k -n vite,electron \"vite\" \"electron . --dev\"",
    "build:web": "vite build",
    "build:backend": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1':'bash ../scripts/build-backend.sh',{stdio:'inherit'})\"",
    "build": "npm run build:web && npm run build:backend && electron-builder --win nsis",
    "build:linux": "npm run build:web && npm run build:backend && electron-builder --linux AppImage deb",
    "test": "node --test tests/updates.test.js"
  },
  "build": {
    "appId": "com.local-file-assistant.app",
    "productName": "Lumi AI",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/lfa-backend",
        "to": "backend"
      },
      {
        "from": "../backend/dist/ovms",
        "to": "ovms"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "LumiAI-OpenVINO-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Tarun Verma <tarunverma0119@gmail.com>",
      "synopsis": "Ask questions about your own files, privately and offline"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tarun81-ops",
        "repo": "local-agentic-openvino"
      }
    ]
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  }
}
