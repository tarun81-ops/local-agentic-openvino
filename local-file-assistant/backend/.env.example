# Leave API_TOKEN empty: the desktop app passes a fresh token each launch, and a backend
# started on its own generates one and prints it (also saved in the data folder).
API_TOKEN=
# OpenVINO Model Server (scripts\ovms-start.ps1). Model names are the aliases given at export
# time (scripts\ovms-export.ps1), so they stay "chat" and "embed" whichever model you export.
OV_BASE_URL=http://127.0.0.1:8000/v3
OV_CHAT_MODEL=chat
EMBEDDING_MODEL=embed
# Qwen3 models think out loud unless this is true (sent as chat_template_kwargs).
OV_DISABLE_THINKING=true
# Extra folders to watch, comma-separated. Normally you add folders from the Index page.
WATCH_FOLDERS=

# RAM: unload voice models after this many idle seconds (0 = never); skip embeddings
# while free RAM is below MIN_FREE_RAM_MB (those files get vectors on the next scan).
LLM_IDLE_UNLOAD_S=600
MIN_FREE_RAM_MB=1200
# Describe images with the vision model while indexing (needs a vision model exported as "chat").
CAPTION_IMAGES=false
